{
  "name": "dsh-ppt-workbench",
  "version": "0.14.3",
  "private": true,
  "description": "Artifact Workbench：在右侧栏浏览/批注/编辑 dsh 生成的交付物（当前支持 PPTX 编辑与 PDF 批注）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "test/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CONTRACT.md",
    "EDIT-CONTRACT.md",
    "lib/edit_ops.py",
    "EDIT-UX-CONTRACT.md",
    "ROADMAP.md",
    "P2-CONTRACT.md",
    "lib/artifacts/",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "P3-CONTRACT.md",
    "editor/",
    "P4-CONTRACT.md",
    "P4-DRAWIO-ANNOTATIONS.md",
    "P4-H5-CONTRACT.md",
    "lib/html-bridge.js",
    "lib/feishu.mjs",
    "test/feishu-smoke.mjs",
    "P5.1-FEISHU-TAB.md",
    "test/fixtures/fake-lark-cli",
    "P5.2-FEISHU-WORKBENCH.md",
    "lib/feishu-oauth.mjs",
    "test/feishu-oauth.mjs",
    "test/p0-regression.mjs",
    "P0-FIX-CONTRACT.md",
    "test/history-immutable.mjs"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/host-smoke.mjs && node test/annotation-multi.mjs && node test/annotation-concurrency.mjs && node test/edit-smoke.mjs && node test/edit-http.mjs && node test/pdf-smoke.mjs && node test/pdf-http.mjs && node test/html-smoke.mjs && node test/diagram-smoke.mjs && node test/editor-assets.mjs && node test/drawio-annotations.mjs && node test/html-artifact.mjs && node test/feishu-smoke.mjs && node test/feishu-oauth.mjs && node test/p0-regression.mjs && node test/history-immutable.mjs && node test/source-http.mjs && node test/annotation-schema.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "artifact-workbench",
    "pptx",
    "pdf",
    "annotations"
  ]
}
